<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE stays on). Only what build settings cannot say:
  an array. The wildcard lets each transcription submit its own continued-processing task (TranscriptionService).
-->
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.NightGard.Transcription-Keeper.transcribe.*</string>
	</array>
</dict>
</plist>
